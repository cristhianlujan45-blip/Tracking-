# Proveedor de generación:
#   mock  -> sin GPU ni claves, modelos de prueba
#   local -> IA real en tu propia GPU (inicia gpu_worker, ver gpu_worker/README.md)
#   fal   -> IA real en la nube vía fal.ai (de pago por uso)
GEN_PROVIDER=mock

# Worker de IA local (sólo si GEN_PROVIDER=local)
LOCAL_WORKER_URL=http://127.0.0.1:8001
LOCAL_WORKER_TOKEN=

# Clave de https://fal.ai/dashboard/keys (sólo si GEN_PROVIDER=fal)
FAL_KEY=

# Modelos de fal.ai (opcional)
# Imagen -> 3D: fal-ai/trellis | fal-ai/hunyuan3d/v2
FAL_IMAGE_TO_3D_MODEL=fal-ai/trellis
# Varias imágenes -> 3D
FAL_MULTI_IMAGE_MODEL=fal-ai/trellis/multi
# Texto -> imagen (primer paso de texto -> 3D)
FAL_TEXT_TO_IMAGE_MODEL=fal-ai/flux/schnell

# Blender para exportar FBX/.blend (se detecta solo si está en la ruta de instalación habitual).
# Puede ser blender.exe o un Python con el módulo bpy.
BLENDER_PATH=

# Directorio donde se guardan la base de datos, imágenes y modelos
DATA_DIR=./data
# Trabajos de generación simultáneos
MAX_CONCURRENT_JOBS=2
# Segundos que tarda cada paso simulado del proveedor mock
MOCK_STEP_DELAY=0.6
